# Copie para .env e preencha com os valores reais do seu projeto Supabase
# (Project Settings > API no painel do Supabase). Nunca commite o .env real.

# Supabase Auth + client público (a anon key é destinada a ser pública —
# a proteção real vem das políticas RLS/das checagens de req.user.uid no
# backend, não do sigilo desta chave).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Conexão com o Postgres (Supabase), usada pelo backend via Drizzle.
# Nunca exponha estas credenciais no frontend.
#
# Em ambiente serverless (Vercel), use o CONNECTION POOLER do Supabase
# (painel > Connect > aba "Transaction pooler"), NUNCA a conexão direta
# (porta 5432) — cada invocação serverless abre seu próprio pool, e a
# conexão direta esgota o limite de conexões do Postgres rapidinho sob
# uso concorrente. O pooler já foi feito pra isso.
#   SQL_HOST=aws-0-<região>.pooler.supabase.com
#   SQL_PORT=6543
#   SQL_USER=postgres.<ID do projeto>
SQL_HOST=
SQL_PORT=6543
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Correção de redações por IA (api/redacao.js)
OPENAI_API_KEY=
OPENAI_MODEL=

# Pagamentos (Mercado Pago) — api/payments.js, api/payments/webhook.js e
# api/payments/confirm.js.
# Access Token: painel do Mercado Pago > Suas integrações > (sua aplicação) >
# Credenciais de produção. Credenciais de teste (TEST-...) abrem o sandbox.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook: Suas integrações > (sua aplicação) >
# Webhooks > Configurar notificações. URL: https://SEU_DOMINIO/api/payments/webhook
# Eventos: "Pagamentos" e "Planos e assinaturas". Sem este segredo o
# webhook recusa TODAS as notificações (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=
# Modo de cobrança do PRO: em branco = pagamento único no PIX ou cartão que
# dá 30 dias (R$ 29,90) ou 1 ano (R$ 239,90), sem renovação automática;
# "subscription" = assinatura recorrente (no Mercado Pago, só cartão).
MERCADOPAGO_BILLING_MODE=
# URL pública onde este app está hospedado (sem barra no final), usada para
# montar a URL de volta do checkout e a do webhook. Ex: https://seudominio.com.br
APP_BASE_URL=
