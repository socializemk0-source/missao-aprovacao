# Copie para .env e preencha com os valores reais do seu projeto Supabase
# (Project Settings > API no painel do Supabase). Nunca commite o .env real.

# Supabase Auth + client público (a anon key é destinada a ser pública —
# a proteção real vem das políticas RLS/das checagens de req.user.uid no
# backend, não do sigilo desta chave).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Conexão com o Postgres (Supabase), usada pelo backend via Drizzle.
# Nunca exponha estas credenciais no frontend.
#
# Em ambiente serverless (Vercel), use o CONNECTION POOLER do Supabase
# (painel > Connect > aba "Transaction pooler"), NUNCA a conexão direta
# (porta 5432) — cada invocação serverless abre seu próprio pool, e a
# conexão direta esgota o limite de conexões do Postgres rapidinho sob
# uso concorrente. O pooler já foi feito pra isso.
#   SQL_HOST=aws-0-<região>.pooler.supabase.com
#   SQL_PORT=6543
#   SQL_USER=postgres.<ID do projeto>
SQL_HOST=
SQL_PORT=6543
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Correção de redações por IA (api/redacao.js)
OPENAI_API_KEY=
OPENAI_MODEL=

# Pagamentos (AbacatePay / Subscriptions) — api/payments.js
# O Plano PRO é uma cobrança RECORRENTE de R$ 29,90/mês, não um pagamento
# único. API Key: painel da AbacatePay > Integração > Criar Chave. Use uma
# chave de Dev mode até validar o fluxo inteiro; troque para a de produção
# só quando for cobrar de verdade (o mesmo endpoint atende as duas — o modo
# é definido pela chave usada).
ABACATEPAY_API_KEY=
# Produto (Plano PRO, R$ 29,90/mês) criado uma vez no painel ou via
# POST /products/create (price=2990 em centavos, currency=BRL,
# cycle=MONTHLY) — cole aqui o "id" (prod_...) que a API devolveu.
ABACATEPAY_PRODUCT_ID=
# Segredo que você escolhe ao cadastrar o webhook no painel da AbacatePay
# (vai na query string da URL do webhook: .../api/payments/webhook?webhookSecret=ESTE_VALOR).
# Sem isso o webhook recusa TODAS as notificações por padrão (fail-closed) —
# nunca deixe em branco em produção.
ABACATEPAY_WEBHOOK_SECRET=
# Chave pública da AbacatePay usada para validar a assinatura HMAC de cada
# webhook (X-Webhook-Signature) — ver a documentação de segurança de
# webhooks deles para onde encontrar essa chave.
ABACATEPAY_WEBHOOK_PUBLIC_KEY=
# URL pública onde este app está hospedado (sem barra no final), usada para
# montar a completionUrl do checkout. Ex: https://seudominio.com.br
APP_BASE_URL=
