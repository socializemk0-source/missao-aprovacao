    if(!fb||!user)return;
    setSyncing(!0);
    try{
      await fb.syncUserStats(user.uid,{
        xp:e.xp,
        streak:e.streak||1,
        hearts:e.hearts||5,
        targetExam,
        lastStudyDate:new Date().toISOString().split("T")[0]
      });
      for(let mid of e.completed){
        await fb.syncMissionProgress(user.uid,mid,4,4);
      }
      let fresh=await fb.getUserDetailedProgress(user.uid);
      if(fresh)setProgressData(fresh);
      setStatusMsg("Nuvem atualizada com sucesso!");
    }catch(err){
      setStatusMsg("Erro na sincronização.");
    }finally{
      setSyncing(!1);
      setTimeout(()=>setStatusMsg(""),3500);
    }
  }

  let xpTotal=profile?.xp??e.xp;
  let streakDays=profile?.streak??(e.streak||1);
