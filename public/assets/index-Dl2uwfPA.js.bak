lp-footer`,children:[(0,G.jsx)(ct,{}),(0,G.jsx)(`p`,{children:`Estude hoje. Conquiste amanhã.`}),(0,G.jsx)(`a`,{href:`#duvidas`,children:`Dúvidas`}),(0,G.jsx)(`a`,{href:`/privacidade`,children:`Privacidade`}),(0,G.jsxs)(`span`,{children:[(0,G.jsx)(te,{size:15,fill:`currentColor`}),` Feito para quem acredita no próprio futuro.`]})]})]})}function dt(){let[e,t]=(0,C.useState)(null),[n,r]=(0,C.useState)(!1),i=e===2;return(0,G.jsxs)(`div`,{className:`lp-demo-grid`,children:[(0,G.jsxs)(`article`,{className:`lp-question-card`,children:[(0,G.jsx)(`span`,{className:`lp-card-label`,children:`1. Seu desafio`}),(0,G.jsx)(`h3`,{children:`Em um simulado de 40 questões, você acertou 30. Qual foi o percentual de acertos?`}),(0,G.jsx)(`div`,{className:`lp-demo-options`,children:[`60%`,`70%`,`75%`,`80%`].map((r,i)=>(0,G.jsxs)(`button`,{disabled:n,"aria-pressed":e===i,className:`${e===i?`selected`:``} ${n&&i===2?`is-correct`:``}`,onClick:()=>t(i),children:[(0,G.jsx)(`span`,{children:String.fromCharCode(65+i)}),r,n&&i===2&&(0,G.jsx)(R,{size:17})]},r))}),(0,G.jsxs)(`button`,{className:`lp-demo-confirm`,disabled:e===null||n,onClick:()=>r(!0),children:[n?`Resposta conferida`:`Conferir resposta`,(0,G.jsx)(A,{size:16})]})]}),(0,G.jsx)(A,{className:`lp-demo-arrow`}),(0,G.jsxs)(`article`,{className:`lp-explanation ${n?`revealed`:``}`,"aria-live":`polite`,children:[(0,G.jsx)(`span`,{className:`lp-card-label`,children:`2. Entenda e evolua`}),n?(0,G.jsxs)(G.Fragment,{children:[(0,G.jsxs)(`span`,{className:`lp-feedback ${i?`correct`:`learning`}`,children:[(0,G.jsx)(R,{size:24}),i?`Boa! Você acertou.`:`Uma descoberta para levar.`]}),(0,G.jsx)(`h3`,{children:`30 de 40 é o mesmo que 75 de 100.`}),(0,G.jsx)(`p`,{children:`Divida os acertos pelo total de questões e multiplique por 100:`}),(0,G.jsxs)(`div`,{className:`lp-formula`,children:[`30 ÷ 40 × 100 = `,(0,G.jsx)(`strong`,{children:`75%`})]}),(0,G.jsxs)(`button`,{className:`lp-demo-reset`,onClick:()=>{t(null),r(!1)},children:[(0,G.jsx)(ve,{size:15}),`Tentar novamente`]})]}):(0,G.jsxs)(G.Fragment,{children:[(0,G.jsx)(j,{size:37}),(0,G.jsx)(`h3`,{children:`O melhor vem depois da resposta.`}),(0,G.jsx)(`p`,{children:`Escolha uma alternativa ao lado e confira. Você vai entender o caminho até a resposta certa.`}),(0,G.jsx)(`span`,{className:`lp-demo-tag`,children:`Demonstração · não altera seu progresso`})]})]}),(0,G.jsxs)(`div`,{className:`lp-demo-tico`,children:[(0,G.jsxs)(`div`,{children:[`Você consegue.`,(0,G.jsx)(`br`,{}),(0,G.jsx)(`strong`,{children:`Um passo de cada vez!`})]}),(0,G.jsx)(Le,{pose:n?i?4:3:1,size:230})]})]})}var ft={label:`CERT.br — Cartilha de Segurança para Internet`,url:`https://cartilha.cert.br/fasciculos/`},pt={label:`Lei 9.784/1999 — processo administrativo federal`,url:`https://www.planalto.gov.br/ccivil_03/leis/l9784.htm`},mt=[{id:`mx-conectivos`,mode:`match`,subject:`portugues`,topic:`Interpretação de texto`,title:`Pontes entre ideias`,brief:`Ligue cada relação ao conectivo que a expressa neste contexto.`,explanation:`O conectivo orienta a relação entre as ideias. Leia a frase inteira antes de associar.`,pairs:[[`Oposição`,`Estudou, porém ainda tem dúvidas.`,`“Porém” contrapõe o estudo à persistência das dúvidas.`],[`Conclusão`,`Revisou o tema; portanto, avançou.`,`“Portanto” apresenta uma conclusão.`],[`Condição`,`Se enviar os documentos, o pedido seguirá.`,`“Se” introduz uma condição.`],[`Concessão`,`Embora cansada, continuou a leitura.`,`“Embora” indica uma circunstância que não impediu a ação.`]]},{id:`mx-texto`,mode:`match`,subject:`portugues`,topic:`Interpretação de texto`,title:`O texto está dizendo o quê?`,brief:`Encontre a frase que exemplifica cada tipo de informação.`,explanation:`Informação expressa, hipótese, opinião e restrição não são intercambiáveis.`,pairs:[[`Fato afirmado no texto`,`A reunião começou às 10h.`,`A frase afirma um acontecimento, sem indicar hipótese.`],[`Hipótese`,`Talvez o setor abra amanhã.`,`“Talvez” marca incerteza.`],[`Opinião`,`Na minha avaliação, o atendimento foi excelente.`,`Há uma avaliação pessoal explícita.`],[`Restrição`,`A entrada é permitida apenas aos inscritos.`,`“Apenas” restringe quem pode entrar.`]]},{id:`mx-fracoes`,mode:`match`,subject:`matematica`,topic:`porcentagem`,title:`Partes que se encontram`,brief:`Associe cada fração ao percentual equivalente.`,explanation:`Divida o numerador pelo denominador e multiplique por 100.`,pairs:[[`1/2`,`50%`,`1 ÷ 2 = 0,5.`],[`1/4`,`25%`,`1 ÷ 4 = 0,25.`],[`3/4`,`75%`,`3 ÷ 4 = 0,75.`],[`1/5`,`20%`,`1 ÷ 5 = 0,2.`]]},{id:`mx-calculos`,mode:`match`,subject:`matematica`,topic:`porcentagem`,title:`A operação certa`,brief:`Ligue cada pergunta ao cálculo que a resolve.`,explanation:`Identifique se você busca uma parte, uma proporção, uma média ou o valor restante.`,pairs:[[`20% de 150`,`150 × 20 ÷ 100`,`O percentual multiplica o valor-base.`],[`Percentual de 30 em 120`,`30 ÷ 120 × 100`,`Divida a parte pelo total.`],[`Média de 8, 10 e 12`,`(8 + 10 + 12) ÷ 3`,`Some e divida pela quantidade de valores.`],[`Preço de 80 com desconto de 10`,`80 − 10`,`O desconto já está em reais, não em percentual.`]]},{id:`mx-seguranca`,mode:`match`,subject:`informatica`,topic:`Segurança digital`,title:`Cada risco, um cuidado`,brief:`Associe o problema ao cuidado mais diretamente relacionado.`,explanation:`As medidas se complementam; cada associação destaca a proteção mais direta para o problema descrito.`,source:ft,pairs:[[`Perda de arquivos`,`Backup com restauração testada`,`A cópia testada permite recuperar conteúdo.`],[`Mensagem suspeita`,`Conferência por canal independente`,`Não use a própria mensagem como prova de autenticidade.`],[`Senha vazada em outro serviço`,`Senhas diferentes por serviço`,`Evita que a mesma senha facilite acesso a outras contas.`],[`Acesso só com senha roubada`,`Autenticação em dois fatores`,`Um segundo fator adiciona uma etapa de proteção.`]]},{id:`mx-arquivos`,mode:`match`,subject:`informatica`,topic:`Dados e arquivos`,title:`Organize a mesa digital`,brief:`Ligue cada conceito à sua finalidade principal.`,explanation:`Organização, cópia, sincronização e recuperação são funções diferentes.`,pairs:[[`Pasta`,`Agrupar arquivos e subpastas`,`Uma pasta organiza, não cria automaticamente cópias.`],[`Backup`,`Manter cópias para recuperação`,`A cópia precisa ser utilizável quando necessária.`],[`Sincronização`,`Propagar alterações entre locais`,`Alterações podem incluir exclusões.`],[`Restauração`,`Recuperar conteúdo a partir de uma cópia`,`Restaurar é usar a cópia para recuperar dados.`]]},{id:`mx-principios`,mode:`match`,subject:`administrativo`,topic:`Princípios e processo`,title:`Princípios em ação`,brief:`No processo administrativo federal, relacione cada conceito ao exemplo.`,explanation:`A Lei 9.784/1999, art. 2º, orienta a atuação administrativa por esses critérios.`,source:pt,pairs:[[`Motivação`,`Explicar os fatos e normas que fundamentam a decisão`,`O art. 2º, parágrafo único, VII trata desses fundamentos.`],[`Proporcionalidade`,`Evitar restrição maior do que a necessária`,`O art. 2º, parágrafo único, VI exige adequação entre meios e fins.`],[`Interesse público`,`Agir sem promover pessoalmente a autoridade`,`O art. 2º, parágrafo único, III veda promoção pessoal.`],[`Boa-fé`,`Atuar com lealdade e padrões éticos`,`O art. 2º, parágrafo único, IV menciona probidade, decoro e boa-fé.`]]},{id:`mx-atendimento`,mode:`match`,subject:`administrativo`,topic:`Princípios e processo`,title:`Direitos no atendimento`,brief:`Associe cada situação à orientação da Lei 9.784/1999.`,explanation:`Receber, orientar e permitir participação não significam aprovar automaticamente o pedido.`,source:pt,pairs:[[`Falha corrigível no requerimento`,`Orientar o interessado sobre como suprir a falha`,`Art. 6º, parágrafo único.`],[`Documentos antes da decisão`,`Considerar o material apresentado pelo interessado`,`Art. 3º, III.`],[`Atendimento ao administrado`,`Tratar com respeito e facilitar o exercício de direitos`,`Art. 3º, I.`],[`Advogado no processo`,`Assistência facultativa, salvo exigência legal`,`Art. 3º, IV.`]]}],ht=[{id:`or-desconto`,mode:`order`,subject:`matematica`,topic:`porcentagem`,title:`O desconto sem atalhos`,brief:`Organize a resolução: um material de R$ 250 recebeu 12% de desconto.`,steps:[`Identificar a base: R$ 250.`,`Calcular o desconto: 250 × 12 ÷ 100 = 30.`,`Subtrair o desconto: 250 − 30 = 220.`,`Responder: o valor pago foi R$ 220.`],explanation:`R$ 30 é o desconto, não o preço final. A sequência separa a base, o cálculo e a interpretação.`},{id:`or-aumento`,mode:`order`,subject:`matematica`,topic:`porcentagem`,title:`Estoque em crescimento`,brief:`Organize o cálculo de um estoque de 80 unidades que aumenta 25%.`,steps:[`Identificar o estoque inicial: 80 unidades.`,`Calcular 25% de 80: 20 unidades.`,`Somar: 80 + 20 = 100.`,`Interpretar: o estoque passou a 100 unidades.`],explanation:`O aumento é somado à base. Não se soma o número 25 diretamente ao estoque.`},{id:`or-sucessivos`,mode:`order`,subject:`matematica`,topic:`porcentagem`,title:`A base mudou!`,brief:`Monte a resolução de R$ 100 com aumento de 10% e depois desconto de 10%.`,steps:[`Calcular o aumento: 100 × 0,10 = 10.`,`Encontrar a nova base: 100 + 10 = 110.`,`Calcular o desconto sobre 110: 110 × 0,10 = 11.`,`Encontrar o preço final: 110 − 11 = 99.`],explanation:`Os percentuais incidem sobre bases diferentes. O resultado final é R$ 99.`},{id:`or-media`,mode:`order`,subject:`matematica`,topic:`media`,title:`Média da semana`,brief:`Organize a média de 12, 18 e 24 atendimentos em três dias.`,steps:[`Identificar os três valores: 12, 18 e 24.`,`Somar os atendimentos: 12 + 18 + 24 = 54.`,`Dividir pelo número de dias: 54 ÷ 3 = 18.`,`Concluir: a média foi de 18 atendimentos por dia.`],explanation:`Divida pela quantidade de observações, não pelo maior valor.`},{id:`or-proporcao`,mode:`order`,subject:`matematica`,topic:`proporcao`,title:`Ritmo de trabalho`,brief:`Mantendo o mesmo ritmo, uma equipe analisa 15 pedidos em 30 minutos. Monte o cálculo para 90 minutos.`,steps:[`Identificar a referência: 15 pedidos em 30 minutos.`,`Calcular quantos intervalos cabem: 90 ÷ 30 = 3.`,`Multiplicar os pedidos por 3: 15 × 3 = 45.`,`Concluir: serão 45 pedidos, se o ritmo for mantido.`],explanation:`O tempo triplica e, sob a condição de ritmo constante, a quantidade também triplica.`},{id:`or-comunicado`,mode:`order`,subject:`portugues`,topic:`Interpretação de texto`,title:`Um comunicado com começo e fim`,brief:`Organize o comunicado. As expressões “por esse motivo” e “após o reparo” indicam as dependências.`,steps:[`O sistema apresentou uma falha nesta manhã.`,`Por esse motivo, o atendimento foi interrompido.`,`A equipe técnica realizou o reparo.`,`Após o reparo, o atendimento foi retomado.`],explanation:`A causa antecede sua consequência. A retomada indicada no texto ocorre depois do reparo.`},{id:`or-backup`,mode:`order`,subject:`informatica`,topic:`Dados e arquivos`,title:`Cópia que realmente funciona`,brief:`Neste exercício, a equipe definiu este procedimento: escolher os arquivos, copiar, restaurar uma amostra e conferir. Organize-o.`,steps:[`Selecionar os arquivos que precisam ser protegidos.`,`Criar uma cópia em local apropriado.`,`Restaurar uma amostra dessa cópia em ambiente de teste.`,`Conferir se os arquivos restaurados podem ser usados.`],explanation:`É necessário ter a cópia antes de testar a restauração e conferir seu resultado. O exercício representa um procedimento definido, não a única política possível.`,source:ft},{id:`or-prazo`,mode:`order`,subject:`administrativo`,topic:`Rotina administrativa`,title:`Fluxo combinado`,brief:`A regra interna deste cenário é: receber, conferir, registrar e encaminhar. Monte esse fluxo fictício de triagem.`,steps:[`Receber o pedido apresentado.`,`Conferir os dados conforme a lista do setor.`,`Registrar o pedido no sistema.`,`Encaminhar o registro à unidade responsável.`],explanation:`A sequência segue a regra expressamente dada pelo cenário. Não é uma regra universal de protocolo nem substitui normas do órgão.`}];function gt(e,t,n,r,i,a,o,s,c){let l=e.length%3;return{id:e,mode:`error`,subject:t,topic:n,title:r,brief:`Toque no trecho que contém o erro. Depois escolha a correção adequada.`,segments:i,errorIndex:a,corrections:o.slice(l).concat(o.slice(0,l)),correct:(3-l)%3,explanation:s,source:c}}var _t=[gt(`er-concordancia`,`portugues`,`Concordância verbal`,`O aviso da recepção`,[`Os documentos`,`foi conferidos`,`pela equipe.`],1,[`foram conferidos`,`foi conferido`,`foram conferido`],`O sujeito “os documentos” está no plural. A forma correta é “foram conferidos”.`),gt(`er-tempo`,`portugues`,`Concordância verbal`,`Há quanto tempo?`,[`Fazem dois meses`,`que o setor`,`mudou de endereço.`],0,[`Faz dois meses`,`Fazem dois mês`,`Faz dois mês`],`“Fazer” indicando tempo decorrido é impessoal e fica no singular: faz dois meses.`),gt(`er-porque`,`portugues`,`Ortografia`,`O motivo da mudança`,[`A equipe quer saber`,`porque`,`o prazo mudou.`],1,[`por que`,`porquê`,`por quê`],`Na pergunta indireta, usamos “por que”, no sentido de “por qual motivo”. Não está no fim da frase.`),gt(`er-conectivo`,`portugues`,`Interpretação de texto`,`Conclusão mal interpretada`,[`No aviso “O reparo terminou; portanto, o serviço voltou”,`,`a palavra “portanto” indica oposição.`],1,[`a palavra “portanto” indica conclusão.`,`a palavra “portanto” indica condição.`,`a palavra “portanto” indica dúvida.`],`“Portanto” liga a retomada à conclusão do reparo. Não indica oposição.`),gt(`er-desconto`,`matematica`,`porcentagem`,`Preço ou desconto?`,[`O material custa R$ 400 e tem 10% de desconto.`,`O desconto é R$ 40.`,`O valor pago é R$ 40.`],2,[`O valor pago é R$ 360.`,`O valor pago é R$ 440.`,`O valor pago é R$ 390.`],`O cálculo do desconto está certo. Falta subtraí-lo: 400 − 40 = 360.`),gt(`er-base`,`matematica`,`porcentagem`,`Duas mudanças, duas bases`,[`R$ 100 com aumento de 20% passa a R$ 120.`,`Depois, o desconto de 20% deve ser calculado sobre R$ 100.`],1,[`Depois, o desconto de 20% deve ser calculado sobre R$ 120.`,`Depois, basta subtrair R$ 20.`,`Depois, o preço volta necessariamente a R$ 100.`],`Após o aumento, a nova base é 120. O desconto é 24 e o resultado final é 96.`),gt(`er-https`,`informatica`,`Segurança digital`,`O cadeado não diz tudo`,[`O site usa HTTPS.`,`Isso prova que ele pertence ao órgão público.`],1,[`Ainda é necessário verificar o domínio e a origem.`,`Isso prova que não pode haver fraude.`,`Isso dispensa a verificação do remetente.`],`HTTPS protege o transporte, mas não comprova que a organização alegada é a dona do site.`,ft),gt(`er-recebimento`,`administrativo`,`Princípios e processo`,`Receber não é aprovar`,[`No processo administrativo federal, o servidor deve orientar sobre falhas do requerimento.`,`Ele pode recusar o recebimento sem apresentar motivo.`],1,[`É vedada a recusa imotivada do recebimento.`,`Todo requerimento deve ser aprovado imediatamente.`,`A orientação dispensa a análise do pedido.`],`A Lei 9.784/1999, art. 6º, parágrafo único, veda a recusa imotivada e prevê orientação sobre falhas.`,pt)];function vt(e,t,n,r,i,a,o,s,c,l,u,d){let f=e=>({text:e[0],choices:[{label:e[1],good:!0,consequence:e[3]},{label:e[2],good:!1,consequence:`Essa decisão não resolve o problema apresentado. ${e[3]}`}]});return{id:e,mode:`story`,subject:t,topic:n,title:r,brief:`Ajude a equipe em duas decisões. Cada escolha muda a situação seguinte.`,explanation:`Observe as consequências e use as orientações para decidir melhor na próxima situação.`,source:d,scenes:{start:{text:i,choices:[{label:a,good:!0,consequence:s,next:`follow`},{label:o,good:!1,consequence:c,next:`repair`}]},follow:f(l),repair:f(u)}}}var yt=[vt(`st-mensagem`,`informatica`,`Segurança digital`,`O e-mail urgente`,`Lia recebe uma mensagem dizendo que sua conta será bloqueada em dez minutos. O link pede a senha. O que você sugere?`,`Verificar a solicitação pelo canal oficial conhecido.`,`Abrir o link e informar a senha.`,`A equipe confirmou que a mensagem não veio do suporte. A senha ficou protegida.`,`No cenário, a senha foi enviada a uma página falsa. Agora a conta precisa de atenção.`,[`O suporte confirmou a fraude. Como a equipe deve tratar a mensagem?`,`Seguir o procedimento do órgão para reportar e bloquear a mensagem.`,`Encaminhar o link aos colegas sem explicar que é fraude.`,`Reportar pelo canal adequado ajuda a equipe responsável a agir sem espalhar o golpe.`],[`A senha foi exposta. Qual é a resposta mais adequada?`,`Procurar o suporte oficial e trocar a credencial comprometida em acesso confiável.`,`Esperar a mensagem expirar.`,`Uma credencial exposta exige ação por canal confiável; o prazo anunciado pelo golpista não limita o risco.`],ft),vt(`st-copia`,`informatica`,`Dados e arquivos`,`O arquivo desapareceu`,`Caio apagou um relatório por engano. Existe uma cópia de segurança. Como começar?`,`Verificar a cópia e restaurar uma versão adequada.`,`Criar um arquivo vazio com o mesmo nome e encerrar o caso.`,`Uma versão do relatório foi recuperada. Falta conferir seu conteúdo.`,`O nome voltou à pasta, mas o relatório continua perdido. Um arquivo vazio não recupera os dados.`,[`A versão foi restaurada. O que falta?`,`Abrir e verificar se o conteúdo necessário está íntegro.`,`Concluir que está tudo certo só pelo nome.`,`A conferência valida se a recuperação realmente atende ao que foi perdido.`],[`Ainda existe uma cópia de segurança. Como corrigir a situação?`,`Restaurar o conteúdo da cópia e verificar o resultado.`,`Renomear novamente o arquivo vazio.`,`A recuperação depende do conteúdo da cópia, não apenas do nome do arquivo.`],ft),vt(`st-requerimento`,`administrativo`,`Princípios e processo`,`Um pedido incompleto`,`No atendimento de um órgão federal, falta um dado no requerimento de uma cidadã. Qual atitude respeita a Lei 9.784/1999?`,`Orientar sobre como suprir a falha, sem recusa imotivada.`,`Recusar o recebimento sem explicar o motivo.`,`A cidadã recebeu uma orientação clara e pode corrigir o dado.`,`A recusa sem motivação contrariou o art. 6º, parágrafo único. É necessário corrigir o atendimento.`,[`A cidadã pergunta se corrigir o dado garante aprovação. O que responder?`,`A correção permite seguir o trâmite; o mérito ainda será analisado.`,`A aprovação é automática.`,`Receber e instruir o pedido não significa decidir favoravelmente seu mérito.`],[`Como corrigir o atendimento?`,`Explicar a falha e orientar a cidadã sobre a regularização.`,`Manter a recusa porque o primeiro atendimento já terminou.`,`O servidor deve orientar o interessado quanto ao suprimento das falhas.`],pt),vt(`st-decisao`,`administrativo`,`Princípios e processo`,`Uma decisão precisa de razões`,`Uma minuta de decisão administrativa federal apenas diz “pedido negado”, sem indicar fatos ou normas. Você está revisando a justificativa. O que fazer?`,`Solicitar a indicação dos fundamentos aplicáveis.`,`Trocar apenas o tamanho da fonte e considerar a justificativa completa.`,`A minuta passa a indicar os fatos e normas que sustentam a conclusão.`,`A aparência mudou, mas continuam faltando os fundamentos da decisão.`,[`Com os fundamentos registrados, como revisar uma restrição proposta?`,`Conferir se ela é adequada e necessária ao fim público.`,`Aplicar a medida mais severa só para demonstrar autoridade.`,`A proporcionalidade exige adequação entre meios e fins, evitando excesso desnecessário.`],[`Como completar a justificativa?`,`Explicitar os fatos relevantes e a base jurídica da decisão.`,`Repetir “negado” várias vezes.`,`Motivação envolve razões de fato e de direito, e não a repetição da conclusão.`],pt),vt(`st-compra`,`matematica`,`porcentagem`,`A compra do setor`,`Um material custa R$ 500. O fornecedor oferece 10% de desconto. Qual valor você registra como preço final?`,`R$ 450.`,`R$ 50.`,`O registro separa corretamente R$ 50 de desconto e R$ 450 a pagar.`,`Foi registrado o valor do desconto no lugar do preço final. A planilha precisa ser corrigida.`,[`O orçamento disponível é R$ 480. Quanto resta após a compra?`,`R$ 30.`,`R$ 50.`,`480 − 450 = 30. O saldo usa o preço final, não o desconto.`],[`Qual ajuste corrige o registro?`,`Subtrair o desconto de R$ 50 dos R$ 500: total R$ 450.`,`Somar R$ 50 aos R$ 500.`,`Desconto reduz o preço. A conta correta é 500 − 50 = 450.`]),vt(`st-fila`,`matematica`,`porcentagem`,`A fila em números`,`A equipe concluiu 30 dos 120 pedidos. O relatório pede o percentual concluído. Qual cálculo usar?`,`30 ÷ 120 × 100 = 25%.`,`120 ÷ 30 × 100 = 400%.`,`O relatório informa corretamente que um quarto da fila foi concluído.`,`A divisão foi invertida. A parte precisa ser dividida pelo total.`,[`Quantos pedidos ainda estão pendentes?`,`90 pedidos.`,`25 pedidos.`,`120 − 30 = 90. O percentual concluído não é a quantidade pendente.`],[`Como corrigir o percentual?`,`Dividir os 30 concluídos pelos 120 totais e multiplicar por 100.`,`Usar 30% porque foram 30 pedidos.`,`30 ÷ 120 × 100 = 25%. Quantidade e percentual são medidas diferentes.`]),vt(`st-aviso`,`portugues`,`Interpretação de texto`,`A exceção no aviso`,`O aviso diz: “Atendemos até as 17h, exceto às sextas-feiras, quando encerramos às 13h”. Ana quer ir na sexta às 15h. Qual orientação dar?`,`O atendimento de sexta já terá encerrado.`,`Pode ir, pois o horário geral termina às 17h.`,`Ana percebeu a exceção e pode escolher outro horário.`,`A orientação ignorou a ressalva específica de sexta-feira.`,[`Ana pode ir na sexta às 11h. O que o aviso permite concluir?`,`Esse horário está antes do encerramento informado para sexta.`,`O pedido dela será automaticamente aprovado.`,`O aviso informa um horário, não o resultado de qualquer pedido.`],[`Qual trecho resolve a dúvida?`,`“Às sextas-feiras, quando encerramos às 13h”.`,`Apenas “até as 17h”, ignorando o restante.`,`A regra específica para sexta substitui o horário geral nesse dia.`]),vt(`st-condicao`,`portugues`,`Interpretação de texto`,`Uma condição não é um fato`,`Um comunicado diz: “Se o cadastro for confirmado, a mensagem será enviada”. Rui afirma que a mensagem já foi enviada. Como avaliar?`,`O texto dá uma condição, mas não confirma que ela aconteceu.`,`A afirmação está comprovada pelo comunicado.`,`Rui separou a hipótese do fato e vai buscar confirmação.`,`A conclusão transformou uma condição em um acontecimento confirmado.`,[`Qual informação ajudaria a saber se a condição foi satisfeita?`,`A confirmação do cadastro.`,`A cor do cabeçalho do comunicado.`,`A condição expressa é a confirmação do cadastro.`],[`Como corrigir a conclusão?`,`Dizer que o envio foi condicionado à confirmação, sem afirmar que já ocorreu.`,`Dizer que nenhum cadastro pode ser confirmado.`,`A frase não comprova envio nem impossibilidade de confirmação. Ela estabelece uma condição.`])],bt=[...mt,...ht,..._t,...yt],xt=Object.fromEntries(bt.map(e=>[e.id,e])),St=[{id:`match`,title:`Conexões do Tico`,verb:`Conectar`,description:`Ligue conceitos aos exemplos e descubra as relações.`,color:`#118de1`},{id:`order`,title:`Monte o raciocínio`,verb:`Organizar`,description:`Coloque cada etapa no lugar e chegue à solução.`,color:`#8c61d8`},{id:`error`,title:`Caça ao erro`,verb:`Investigar`,description:`Encontre o trecho problemático e mostre como corrigir.`,color:`#e98937`},{id:`story`,title:`Um dia no setor`,verb:`Decidir`,description:`Ajude a equipe. Suas decisões mudam o próximo passo.`,color:`#26a47a`}];function Ct(e,t){let n=7;for(let e=0;e<t.length;e++)n=Math.imul(n,31)+t.charCodeAt(e)>>>0;let r=Array.from({length:e},(e,t)=>t);for(let t=e-1;t>0;t--){n^=n<<13,n^=n>>>17,n^=n<<5;let e=(n>>>0)%(t+1);[r[t],r[e]]=[r[e],r[t]]}return e>2&&r.every((e,t)=>e===t)&&r.push(r.shift()),r}var wt=()=>({activeId:null,runs:{},records:{}}),Tt=e=>Object.hasOwn(xt,e),Et=(e,t)=>Number.isInteger(e)&&e>=0&&e<t,Dt=e=>({phase:`play`,draft:e.mode===`match`?e.pairs.map(()=>-1):e.mode===`error`?[-1,-1]:[],node:e.mode===`story`?`start`:``,path:[]}),Ot=e=>Object.values(e.records).reduce((e,t)=>e+t.best,0);function kt(e,t){return e.mode===`story`?{correct:t.path.filter(t