function UserProfileView({state:e,explore:t}){
  let[user,setUser]=(0,C.useState)(null),
     [profile,setProfile]=(0,C.useState)(null),
     [progressData,setProgressData]=(0,C.useState)({totalCompleted:e.completed.length,totalQuestionsAnswered:e.completed.length*4,totalCorrect:e.completed.length*4,accuracy:100}),
     [loading,setLoading]=(0,C.useState)(!0),
     [syncing,setSyncing]=(0,C.useState)(!1),
     [targetExam,setTargetExam]=(0,C.useState)("Polícia Federal"),
     [statusMsg,setStatusMsg]=(0,C.useState)(""),
     [authError,setAuthError]=(0,C.useState)("");

  (0,C.useEffect)(()=>{
    let fb=window.FirebaseApplet;
    if(!fb){setLoading(!1);return;}
    let unsub=fb.subscribeAuth(async(authUser)=>{
      if(authUser){
        setUser(authUser);
        try{
          let p=await fb.getUserProfile(authUser.uid);
          if(p){
            setProfile(p);
            if(p.targetExam)setTargetExam(p.targetExam);
          }else{
            let initial={
              uid:authUser.uid,
              name:authUser.displayName||(authUser.isAnonymous?"Concurseiro Visitante":"Concurseiro(a)"),
              email:authUser.email||"",
              targetExam:"Polícia Federal",
              xp:e.xp||0,
              streak:e.streak||1,
              hearts:e.hearts||5,
              lastStudyDate:new Date().toISOString().split("T")[0],
              createdAt:new Date().toISOString()
            };
            await fb.updateUserProfile(authUser.uid,initial);
            setProfile(initial);
          }
          let det=await fb.getUserDetailedProgress(authUser.uid);
          if(det&&det.totalCompleted>0){
            setProgressData(det);
          }else if(e.completed.length>0){
            for(let mid of e.completed){
              await fb.syncMissionProgress(authUser.uid,mid,4,4);
            }
            let freshDet=await fb.getUserDetailedProgress(authUser.uid);
            if(freshDet)setProgressData(freshDet);
          }
        }catch(err){
          console.warn("[Firestore Profile] Erro ao carregar dados:",err);
        }finally{
          setLoading(!1);
        }
      }else{
        try{
          await fb.loginGuest();
        }catch(guestErr){
          console.warn("[Firebase] Falha no login anônimo:",guestErr);
          setLoading(!1);
        }
      }
    });
    return()=>unsub&&unsub();
  },[e.completed.length,e.xp]);

  async function handleGoogleLogin(){
    let fb=window.FirebaseApplet;
    if(!fb)return;
    setSyncing(!0);
    setAuthError("");
    try{
      let u=await fb.loginWithGoogle();
      setUser(u);
      let p=await fb.getUserProfile(u.uid);
      if(p){
        setProfile(p);
        if(p.targetExam)setTargetExam(p.targetExam);
      }
      let det=await fb.getUserDetailedProgress(u.uid);
      if(det)setProgressData(det);
      setStatusMsg("Conta Google conectada com sucesso!");
    }catch(err){
      setAuthError(err.message||"Não foi possível conectar com o Google no momento.");
    }finally{
      setSyncing(!1);
      setTimeout(()=>setStatusMsg(""),4000);
    }
  }

  async function handleLogout(){
    let fb=window.FirebaseApplet;
    if(!fb)return;
    try{
      await fb.logoutUser();
      setUser(null);
      setProfile(null);
      setStatusMsg("Desconectado da conta.");
    }catch(err){
      console.warn("Erro ao desconectar:",err);
    }
  }

  async function handleSaveExam(exam){
    setTargetExam(exam);
    let fb=window.FirebaseApplet;
    if(!fb||!user)return;
    setSyncing(!0);
    try{
      await fb.updateUserProfile(user.uid,{targetExam:exam});
      setProfile(prev=>({...prev,targetExam:exam}));
      setStatusMsg("Concurso-alvo salvo no Firestore!");
    }catch(err){
      console.warn("Erro ao salvar concurso:",err);
    }finally{
      setSyncing(!1);
      setTimeout(()=>setStatusMsg(""),3500);
    }
  }

  async function handleManualSync(){
