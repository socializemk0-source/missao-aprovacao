
function TargetCheckIcon({size=20,className=""}){
  return(0,G.jsxs)(`svg`,{width:size,height:size,viewBox:`0 0 24 24`,fill:`none`,stroke:`currentColor`,strokeWidth:2,strokeLinecap:`round`,strokeLinejoin:`round`,className,children:[
    (0,G.jsx)(`circle`,{cx:12,cy:12,r:10}),
    (0,G.jsx)(`path`,{d:`m9 12 2 2 4-4`}),
    (0,G.jsx)(`path`,{d:`M12 2v2`}),
    (0,G.jsx)(`path`,{d:`M12 20v2`}),
    (0,G.jsx)(`path`,{d:`M20 12h2`}),
    (0,G.jsx)(`path`,{d:`M2 12h2`})
  ]});
}

function DailyMissionsView({state:e,navigate:t}){
  let[missions,setMissions]=(0,C.useState)([]),
     [user,setUser]=(0,C.useState)(null),
     [progressData,setProgressData]=(0,C.useState)({progressMap:{},completed:[],claimed:[],bonusClaimed:!1}),
     [loading,setLoading]=(0,C.useState)(!0),
     [toast,setToast]=(0,C.useState)(""),
     [timeLeft,setTimeLeft]=(0,C.useState)("");

  let todayStr=new Date().toISOString().split("T")[0];

  (0,C.useEffect)(()=>{
    function updateCountdown(){
      let now=new Date();
      let midnight=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1,0,0,0);
      let diff=midnight.getTime()-now.getTime();
      let hours=Math.floor(diff/(1000*60*60));
      let mins=Math.floor((diff%(1000*60*60))/(1000*60));
      setTimeLeft(hours+"h "+mins+"m");
    }
    updateCountdown();
    let interval=setInterval(updateCountdown,60000);
    return()=>clearInterval(interval);
  },[]);

  (0,C.useEffect)(()=>{
    let fb=window.FirebaseApplet;
    if(!fb){setLoading(!1);return;}
    let unsub=fb.subscribeAuth(async(authUser)=>{
      if(authUser){
        setUser(authUser);
        await loadMissionsAndProgress(authUser.uid);
      }else{
        try{
          await fb.loginGuest();
        }catch(err){
          setLoading(!1);
        }
      }
    });
    return()=>unsub&&unsub();
  },[]);

  async function loadMissionsAndProgress(userId){
    let fb=window.FirebaseApplet;
    if(!fb)return;
    try{
      let mList=await fb.fetchDailyMissions(todayStr);
      setMissions(mList||[]);
      if(userId){
        let prog=await fb.getUserDailyProgress(userId,todayStr);
        if(prog)setProgressData(prog);
      }
    }catch(err){
      console.warn("[DailyMissions] Erro:",err);
    }finally{
      setLoading(!1);
    }
  }

  async function handleAdvance(mission){
    let fb=window.FirebaseApplet;
    if(!fb||!user)return;
    try{
      let updated=await fb.updateDailyMissionProgress(user.uid,todayStr,mission.id,1,mission.target);
      if(updated){
        setProgressData(updated);
        let curCount=updated.progressMap[mission.id]||1;
        if(curCount>=mission.target){
          setToast("🎉 Parabéns! Missão \"" + mission.title + "\" concluída! Resgate sua recompensa.");
        }else{
          setToast("Progresso registrado: " + curCount + "/" + mission.target + " em " + mission.discipline);
        }
        setTimeout(()=>setToast(""),3500);
      }
    }catch(err){
      console.warn("Erro ao avançar missão:",err);
    }
  }

  async function handleClaim(mission){
    let fb=window.FirebaseApplet;
    if(!fb||!user)return;
    try{
      let updated=await fb.claimDailyMissionReward(user.uid,todayStr,mission.id,mission.xpReward,mission.gemsReward);
      if(updated){
        setProgressData(updated);
        setToast("🎁 +" + mission.xpReward + " XP e +" + (mission.gemsReward||15) + " Cristais adicionados ao seu perfil!");
        setTimeout(()=>setToast(""),4000);
      }
    }catch(err){
      console.warn("Erro ao resgatar:",err);
    }
  }

  async function handleClaimChest(){
    let fb=window.FirebaseApplet;
    if(!fb||!user)return;
    try{
      let ok=await fb.claimDailyBonusChest(user.uid,todayStr,100,50);
      if(ok){
        setProgressData(prev=>({...prev,bonusClaimed:!0}));
        setToast("🏆 GRANDE BAÚ DIÁRIO ABERTO! +100 XP e +50 Cristais conquistados!");
        setTimeout(()=>setToast(""),4000);
      }
    }catch(err){
      console.warn("Erro ao resgatar baú:",err);
    }
  }

  async function handleRefresh(){
    if(!user)return;
    setLoading(!0);
    await loadMissionsAndProgress(user.uid);
    setToast("Missões e progresso diário atualizados com o Firestore!");
    setTimeout(()=>setToast(""),3000);
  }

  let completedIds=progressData.completed||[];
  let claimedIds=progressData.claimed||[];
  let totalMissions=missions.length||5;
  let completedCount=completedIds.length;
  let chestUnlocked=completedCount>=3;
  let chestProgressPercent=Math.min(100,Math.round((completedCount/3)*100));

  let todayFormatted=new Date().toLocaleDateString("pt-BR",{weekday:"long",day:"numeric",month:"long"});

  return(0,G.jsxs)(`main`,{className:`content-page daily-missions-page`,children:[
    (0,G.jsxs)(`div`,{className:`page-intro`,children:[
      (0,G.jsx)(`span`,{className:`eyebrow`,children:`METAS DIÁRIAS · FIRESTORE AO VIVO`}),
      (0,G.jsx)(`h1`,{children:`Missões Diárias de Estudo`}),
      (0,G.jsx)(`p`,{children:`Tarefas frescas puxadas do Firestore todos os dias para manter o foco, disciplina e constância na sua aprovação.`})
    ]}),
    toast&&(0,G.jsx)(`div`,{className:`profile-toast-success`,role:`status`,children:toast}),
    (0,G.jsxs)(`div`,{className:`daily-header-card`,children:[
      (0,G.jsxs)(`div`,{className:`daily-header-left`,children:[
        (0,G.jsxs)(`span`,{className:`daily-date-tag`,children:[(0,G.jsx)(`span`,{children:`📅`}),todayFormatted]}),
        (0,G.jsx)(`h3`,{children:`Rotina de Aprovação de Hoje`}),
        (0,G.jsxs)(`p`,{children:[`Conclua as tarefas abaixo para ganhar XP, cristais e fortalecer sua memória de longo prazo.`]})
      ]}),
      (0,G.jsxs)(`div`,{className:`daily-header-right`,children:[
        (0,G.jsxs)(`div`,{className:`daily-countdown-box`,children:[
          (0,G.jsx)(`small`,{children:`Renovação em`}),
          (0,G.jsx)(`strong`,{children:timeLeft||`Meia-noite`})
        ]}),
        (0,G.jsx)(`button`,{className:`leaderboard-refresh-btn`,onClick:handleRefresh,disabled:loading,title:`Atualizar tarefas do Firestore`,children:loading?`...`:`↻ Atualizar`})
      ]})
    ]}),
    (0,G.jsxs)(`section`,{className:`daily-grand-chest-card`,children:[
      (0,G.jsx)(`div`,{className:`chest-icon-wrapper`,children:`🎁`}),
      (0,G.jsxs)(`div`,{className:`chest-info`,children:[
        (0,G.jsx)(`span`,{className:`chest-badge`,children:`BAÚ DA VITÓRIA DIÁRIA`}),
        (0,G.jsx)(`h3`,{children:`Meta do Dia: 3 ou mais Missões`}),
        (0,G.jsxs)(`p`,{children:[`Progresso: `,(0,G.jsx)(`strong`,{children:completedCount}),` de 3 necessárias (Bônus especial de +100 XP + 50 Cristais)`]}),
        (0,G.jsx)(`div`,{className:`chest-progress-bar-wrap`,children:(0,G.jsx)(`div`,{className:`chest-progress-bar-fill`,style:{width:chestProgressPercent+`%`}})})
      ]}),
      (0,G.jsx)(`div`,{className:`chest-action`,children:progressData.bonusClaimed?(0,G.jsx)(`button`,{className:`claim-chest-btn claimed`,disabled:!0,children:`✓ Baú Resgatado`}):(0,G.jsx)(`button`,{className:`claim-chest-btn`,disabled:!chestUnlocked,onClick:handleClaimChest,children:chestUnlocked?`🎁 Resgatar Baú (+100 XP)`:`Bloqueado (Complete 3)`})})
    ]}),
    (0,G.jsx)(`section`,{className:`daily-missions-list`,children:missions.map(m=>{
      let currentProgress=progressData.progressMap[m.id]||0;
      let isCompleted=completedIds.includes(m.id)||currentProgress>=m.target;
      let isClaimed=claimedIds.includes(m.id);
      let pct=Math.min(100,Math.round((currentProgress/m.target)*100));

      return(0,G.jsxs)(`div`,{key:m.id,className:`daily-mission-card ${isCompleted?"completed":""} ${isClaimed?"claimed":""}`,children:[
        (0,G.jsx)(`div`,{className:`mission-icon-box`,children:m.icon||`🎯`}),
        (0,G.jsxs)(`div`,{className:`mission-body`,children:[
          (0,G.jsxs)(`div`,{className:`mission-meta-top`,children:[
            (0,G.jsx)(`span`,{className:`mission-discipline-badge`,children:m.discipline}),
            m.badge&&(0,G.jsx)(`span`,{className:`mission-tag-badge`,children:m.badge})
          ]}),
          (0,G.jsx)(`h4`,{className:`mission-title`,children:m.title}),
          (0,G.jsx)(`p`,{className:`mission-desc`,children:m.description}),
          (0,G.jsxs)(`div`,{className:`mission-progress-container`,children:[
            (0,G.jsx)(`div`,{className:`mission-progress-bar-wrap`,children:(0,G.jsx)(`div`,{className:`mission-progress-bar-fill`,style:{width:pct+`%`}})}),
            (0,G.jsxs)(`span`,{className:`mission-progress-text`,children:[Math.min(currentProgress,m.target),` / `,m.target]})
          ]})
        ]}),
        (0,G.jsxs)(`div`,{className:`mission-right-actions`,children:[
          (0,G.jsxs)(`div`,{className:`mission-rewards-pill`,children:[
            (0,G.jsxs)(`span`,{className:`reward-xp`,children:[`+`,m.xpReward,` XP`]}),
            (0,G.jsxs)(`span`,{className:`reward-gems`,children:[`💎 +`,m.gemsReward||15]})
          ]}),
          (0,G.jsxs)(`div`,{className:`mission-action-buttons`,children:[
            isClaimed?(0,G.jsx)(`span`,{className:`mission-claimed-badge`,children:`✓ Resgatada`}):isCompleted?(0,G.jsxs)(`button`,{className:`mission-claim-btn`,onClick:()=>handleClaim(m),children:[`🎁 Resgatar +`,m.xpReward,` XP`]}):(0,G.jsxs)(`div`,{style:{display:`flex`,gap:`6px`,alignItems:`center`},children:[
              (0,G.jsx)(`button`,{className:`mission-start-btn`,onClick:()=>t(m.actionTab||"map"),children:`Treinar ➔`}),
              (0,G.jsx)(`button`,{className:`mission-test-progress-btn`,onClick:()=>handleAdvance(m),title:`Registrar avanço no Firestore`,children:`+1 Concluir`})
            ]})
          ]})
        ]})
      ]});
    })})
  ]});
}

function TrophyIcon({size=20,className=""}){return(0,G.jsxs)(`svg`,{width:size,height:size,viewBox:`0 0 24 24`,fill:`none`,stroke:`currentColor`,strokeWidth:2,strokeLinecap:`round`,strokeLinejoin:`round`,className,children:[(0,G.jsx)(`path`,{d:`M6 9H4.5a2.5 2.5 0 0 1 0-5H6`}),(0,G.jsx)(`path`,{d:`M18 9h1.5a2.5 2.5 0 0 0 0-5H18`}),(0,G.jsx)(`path`,{d:`M4 22h16`}),(0,G.jsx)(`path`,{d:`M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22`}),(0,G.jsx)(`path`,{d:`M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22`}),(0,G.jsx)(`path`,{d:`M18 2H6v7a6 6 0 0 0 12 0V2Z`})]})};

function LeaderboardView({state:e,explore:t,openProfile:n}){
  let[metric,setMetric]=(0,C.useState)("questions"),
     [filterExam,setFilterExam]=(0,C.useState)("todos"),
     [user,setUser]=(0,C.useState)(null),
     [profile,setProfile]=(0,C.useState)(null),
     [cloudEntries,setCloudEntries]=(0,C.useState)([]),
     [loading,setLoading]=(0,C.useState)(!0),
     [syncing,setSyncing]=(0,C.useState)(!1),
     [statusMsg,setStatusMsg]=(0,C.useState)("");

  let baseCommunity=[
    {userId:"c1",name:"Mariana Alencar",targetExam:"Polícia Federal",questionsAnswered:428,streak:34,xp:2840,avatar:"👩‍💼",city:"Brasília/DF"},
    {userId:"c2",name:"Rodrigo Mendonça",targetExam:"PRF",questionsAnswered:386,streak:28,xp:2510,avatar:"👮‍♂️",city:"Curitiba/PR"},
    {userId:"c3",name:"Camila Nogueira",targetExam:"Tribunais (TJ/TRT)",questionsAnswered:352,streak:45,xp:2320,avatar:"⚖️",city:"São Paulo/SP"},
    {userId:"c4",name:"Lucas Furtado",targetExam:"Receita Federal",questionsAnswered:310,streak:22,xp:2050,avatar:"👨‍💻",city:"Belo Horizonte/MG"},
    {userId:"c5",name:"Beatriz Silveira",targetExam:"INSS",questionsAnswered:274,streak:19,xp:1820,avatar:"📑",city:"Recife/PE"},
    {userId:"c6",name:"Gabriel Vasconcelos",targetExam:"Polícia Civil",questionsAnswered:246,streak:15,xp:1640,avatar:"🔍",city:"Rio de Janeiro/RJ"},
    {userId:"c7",name:"Fernanda Castelo",targetExam:"Carreiras Administrativas",questionsAnswered:218,streak:31,xp:1450,avatar:"📊",city:"Fortaleza/CE"},
    {userId:"c8",name:"Thiago Prado",targetExam:"Bancário (BB/Caixa)",questionsAnswered:194,streak:12,xp:1290,avatar:"🏦",city:"Porto Alegre/RS"}
  ];

  (0,C.useEffect)(()=>{
    let fb=window.FirebaseApplet;
    if(!fb){setLoading(!1);return;}
    let unsub=fb.subscribeAuth(async(authUser)=>{
      if(authUser){
        setUser(authUser);
        try{
          let p=await fb.getUserProfile(authUser.uid);
          if(p)setProfile(p);
          let det=await fb.getUserDetailedProgress(authUser.uid);
          let qAnswered=det?.totalQuestionsAnswered||(e.completed.length*4);
          let uStreak=p?.streak||(e.streak||1);
          let uXp=p?.xp||e.xp||0;
          let uTarget=p?.targetExam||"Polícia Federal";
          let uName=p?.name||authUser.displayName||(authUser.isAnonymous?"Você (Concurseiro)":"Você");

          await fb.syncLeaderboardEntry(authUser.uid,{
            name:uName,
            targetExam:uTarget,
            questionsAnswered:qAnswered,
            streak:uStreak,
            xp:uXp,
            photoURL:authUser.photoURL||""
          });

          let docs=await fb.fetchLeaderboard();
          if(docs&&docs.length>0){
            setCloudEntries(docs);
          }
        }catch(err){
          console.warn("[Firestore Leaderboard] Erro ao carregar:",err);
        }finally{
          setLoading(!1);
        }
      }else{
        try{
          await fb.loginGuest();
        }catch(guestErr){
          setLoading(!1);
        }
      }
    });
    return()=>unsub&&unsub();
  },[e.completed.length,e.xp]);

  let currentUserId=user?.uid;
  let userQuestions=profile?.questionsAnswered||(e.completed.length*4);
  let userStreak=profile?.streak||(e.streak||1);
  let userXp=profile?.xp||e.xp||0;
  let userTarget=profile?.targetExam||"Polícia Federal";
  let userName=profile?.name||user?.displayName||(user?.isAnonymous?"Você (Concurseiro)":"Você");

  let currentUserItem={
    userId:currentUserId||"current-user",
    name:userName,
    targetExam:userTarget,
    questionsAnswered:userQuestions,
    streak:userStreak,
    xp:userXp,
    avatar:"🚀",
    photoURL:user?.photoURL||"",
    isCurrentUser:!0,
    city:"Seu Painel"
  };

  let allStudentsMap=new Map();
  baseCommunity.forEach(st=>allStudentsMap.set(st.userId,st));

  cloudEntries.forEach(ce=>{
    if(ce.userId===currentUserId)return;
    allStudentsMap.set(ce.userId,{
      userId:ce.userId,
      name:ce.name||"Concurseiro",
      targetExam:ce.targetExam||"Geral",
      questionsAnswered:Number(ce.questionsAnswered||0),
      streak:Number(ce.streak||1),
      xp:Number(ce.xp||0),
      avatar:"👤",
      photoURL:ce.photoURL||"",
      city:"Online"
    });
  });

  allStudentsMap.set(currentUserItem.userId,currentUserItem);

  let fullList=Array.from(allStudentsMap.values());

  if(filterExam!=="todos"){
    fullList=fullList.filter(st=>st.isCurrentUser||st.targetExam===filterExam);
  }

  fullList.sort((a,b)=>{
    if(metric==="questions")return b.questionsAnswered-a.questionsAnswered;
    if(metric==="streak")return b.streak-a.streak;
    return b.xp-a.xp;
  });

  let userPosition=fullList.findIndex(st=>st.isCurrentUser)+1;
  let top3=fullList.slice(0,3);

  async function handleRefresh(){
    let fb=window.FirebaseApplet;
    if(!fb||!user)return;
    setSyncing(!0);
    try{
      let docs=await fb.fetchLeaderboard();
      if(docs)setCloudEntries(docs);
      setStatusMsg("Classificação do Firestore sincronizada!");
    }catch(err){
      console.warn("Erro ao atualizar ranking:",err);
    }finally{
      setSyncing(!1);
      setTimeout(()=>setStatusMsg(""),3500);
    }
  }

  let filterOptions=[
    {id:"todos",label:"Geral (Todos)"},
    {id:"Polícia Federal",label:"Polícia Federal"},
    {id:"PRF",label:"PRF"},
    {id:"Tribunais (TJ/TRT)",label:"Tribunais"},
    {id:"INSS",label:"INSS"},
    {id:"Receita Federal",label:"Receita Federal"}
  ];

  return(0,G.jsxs)(`main`,{className:`content-page leaderboard-page`,children:[
    (0,G.jsxs)(`div`,{className:`page-intro`,children:[
      (0,G.jsx)(`span`,{className:`eyebrow`,children:`COMPETIÇÃO SAUDÁVEL · BANCO DE QUESTÕES FIRESTORE`}),
      (0,G.jsx)(`h1`,{children:`Quadro de Honra dos Concursos`}),
      (0,G.jsx)(`p`,{children:`Acompanhe a liderança dos estudantes por número de questões resolvidas e sequência ininterrupta de estudos.`})
    ]}),
    (0,G.jsxs)(`div`,{className:`leaderboard-controls-bar`,children:[
      (0,G.jsxs)(`div`,{className:`metric-toggle-group`,role:`tablist`,"aria-label":`Métrica de classificação`,children:[
        (0,G.jsxs)(`button`,{className:`metric-toggle-btn ${metric==="questions"?"active":""}`,onClick:()=>setMetric("questions"),children:[(0,G.jsx)(`span`,{children:`🎯`}),`Mais Questões`]}),
        (0,G.jsxs)(`button`,{className:`metric-toggle-btn ${metric==="streak"?"active":""}`,onClick:()=>setMetric("streak"),children:[(0,G.jsx)(`span`,{children:`🔥`}),`Maior Ofensiva`]}),
        (0,G.jsxs)(`button`,{className:`metric-toggle-btn ${metric==="xp"?"active":""}`,onClick:()=>setMetric("xp"),children:[(0,G.jsx)(`span`,{children:`⚡`}),`Mais XP Total`]})
      ]}),
      (0,G.jsxs)(`div`,{className:`leaderboard-actions-right`,children:[
        (0,G.jsxs)(`div`,{className:`leaderboard-db-badge`,children:[(0,G.jsx)(`span`,{className:`db-indicator-dot`}),`Firestore: `,loading?`Carregando...`:`Ao Vivo`]}),
        (0,G.jsx)(`button`,{className:`leaderboard-refresh-btn`,onClick:handleRefresh,disabled:syncing,title:`Atualizar ranking do Firestore`,children:syncing?`...`:`↻ Atualizar`})
      ]})
    ]}),
    statusMsg&&(0,G.jsx)(`div`,{className:`profile-toast-success`,role:`status`,children:statusMsg}),
    (0,G.jsx)(`div`,{className:`exam-filter-scroll`,children:filterOptions.map(opt=>(0,G.jsx)(`button`,{key:opt.id,className:`filter-chip ${filterExam===opt.id?"active":""}`,onClick:()=>setFilterExam(opt.id),children:opt.label}))}),
    (0,G.jsxs)(`section`,{className:`user-ranking-spotlight`,children:[
      (0,G.jsxs)(`div`,{className:`spotlight-left`,children:[
        (0,G.jsxs)(`span`,{className:`spotlight-pos-tag`,children:[`Sua Posição: #`,(0,G.jsx)(`strong`,{children:userPosition})]}),
        (0,G.jsx)(`h3`,{children:userName}),
        (0,G.jsxs)(`p`,{children:[`Foco: `,(0,G.jsx)(`strong`,{children:userTarget}),` · `,userPosition<=3?`Você está no Pódio de Honra! Continue na ponta!`:`Resolva mais questões diárias para avançar até o Top 3!`]})
      ]}),
      (0,G.jsxs)(`div`,{className:`spotlight-metrics`,children:[
        (0,G.jsxs)(`div`,{className:`spotlight-metric-item`,children:[(0,G.jsx)(`span`,{className:`spotlight-val`,children:userQuestions}),(0,G.jsx)(`small`,{children:`Questões`})]}),
        (0,G.jsxs)(`div`,{className:`spotlight-metric-item flame`,children:[(0,G.jsxs)(`span`,{className:`spotlight-val`,children:[userStreak,`d`]}),(0,G.jsx)(`small`,{children:`Ofensiva`})]}),
        (0,G.jsxs)(`div`,{className:`spotlight-metric-item xp`,children:[(0,G.jsx)(`span`,{className:`spotlight-val`,children:userXp}),(0,G.jsx)(`small`,{children:`XP`})]} )
      ]})
    ]}),
    (0,G.jsx)(`section`,{className:`podium-container`,children:(0,G.jsxs)(`div`,{className:`podium-grid`,children:[
      top3[1]&&(0,G.jsxs)(`div`,{className:`podium-card rank-2 ${top3[1].isCurrentUser?"is-me":""}`,children:[
        (0,G.jsx)(`div`,{className:`podium-badge silver`,children:`2º`}),
        (0,G.jsx)(`div`,{className:`podium-avatar`,children:top3[1].photoURL?(0,G.jsx)(`img`,{src:top3[1].photoURL,alt:top3[1].name}):(0,G.jsx)(`span`,{children:top3[1].avatar||`🥈`})}),
        (0,G.jsx)(`strong`,{className:`podium-name`,children:top3[1].name}),
        (0,G.jsx)(`span`,{className:`podium-exam`,children:top3[1].targetExam}),
        (0,G.jsx)(`div`,{className:`podium-score`,children:metric==="questions"?top3[1].questionsAnswered+" questões":metric==="streak"?top3[1].streak+" dias seguidos":top3[1].xp+" XP"}),
        (0,G.jsx)(`div`,{className:`podium-pillar rank-2-pillar`})
      ]}),
      top3[0]&&(0,G.jsxs)(`div`,{className:`podium-card rank-1 ${top3[0].isCurrentUser?"is-me":""}`,children:[
        (0,G.jsx)(`div`,{className:`podium-crown`,children:`👑`}),
        (0,G.jsx)(`div`,{className:`podium-badge gold`,children:`1º`}),
        (0,G.jsx)(`div`,{className:`podium-avatar gold-border`,children:top3[0].photoURL?(0,G.jsx)(`img`,{src:top3[0].photoURL,alt:top3[0].name}):(0,G.jsx)(`span`,{children:top3[0].avatar||`🥇`})}),
        (0,G.jsx)(`strong`,{className:`podium-name`,children:top3[0].name}),
        (0,G.jsx)(`span`,{className:`podium-exam`,children:top3[0].targetExam}),
        (0,G.jsx)(`div`,{className:`podium-score`,children:metric==="questions"?top3[0].questionsAnswered+" questões":metric==="streak"?top3[0].streak+" dias seguidos":top3[0].xp+" XP"}),
